# Values: ollama, openai-compatible
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:4b
# Optional models for the CLI /model command, comma separated.
# A bare name uses MODEL_PROVIDER; prefix another provider, e.g. ollama:qwen3:4b
MODEL_OPTIONS=
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_MS=60000

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Base URL must end at /v1, not /v1/chat/completions.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional search provider. Values: manual, brave, tavily
SEARCH_PROVIDER=manual
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

TRACE_DIR=.data/traces
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=1000000
