{
  "name": "langchain-developer-research-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:plain": "tsx src/cli.ts --plain",
    "server": "langgraphjs dev --port 2024 --no-browser",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run tests/evaluation.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/ollama": "^1.0.0",
    "@langchain/openai": "^1.8.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "ink": "^8.0.0",
    "langchain": "^1.1.0",
    "react": "^19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@langchain/langgraph-cli": "^1.5.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.6"
  }
}
